# PowerContext Server environment for the Docker-free storage mode.
#
# This file stores the context corpus in an EMBEDDED seekdb instance instead
# of a seekdb container.  The instance is the same OceanBase seekdb build
# (VERSION() reports 5.7.25-OceanBase seekdb-v1.4.0.0); it is started by the
# PowerContext Server process through the `pylibseekdb` binding and keeps its
# data in POWERCONTEXT_SERVER_DATABASE_PATH.
#
# Use this file when Docker is not available.  For the container mode use
# `server.env.example` instead.
#
#   cp minimax/env/server.embedded-seekdb.env.example minimax/.runtime/server.env
#
# The path must be absolute and must be written with forward slashes: the
# environment file parser treats a backslash as an escape character.

# --- HTTP listener -----------------------------------------------------------
POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=8010

# --- Persistent store --------------------------------------------------------
# kind=seekdb starts seekdb in-process.  The binding comes from the "seekdb"
# extra of this package:
#
#   uv pip install --python minimax/.venv/Scripts/python.exe "pylibseekdb>=1.4.0.post1,<2"
#
# The upstream PowerContext "seekdb" extra restricts the binding to Linux and
# macOS through an environment marker.  The binding itself also loads on
# Windows 11, which is how the artefacts in this repository were produced.
POWERCONTEXT_SERVER_DATABASE_KIND=seekdb
POWERCONTEXT_SERVER_DATABASE_PATH=<absolute-path-to-the-seekdb-data-directory>

# --- Local behaviour ---------------------------------------------------------
# "disabled" keeps the loopback-only listener unauthenticated, which is what
# the local verification scripts use. Use "enforced" plus
# POWERCONTEXT_SERVER_AUTH_TOKEN for any shared deployment.
POWERCONTEXT_SERVER_ACCESS_MODE=disabled
POWERCONTEXT_SERVER_MCP_ENABLED=false
POWERCONTEXT_SERVER_DASHBOARD_ENABLED=false

# --- Runtime data directory --------------------------------------------------
# Holds server identity and cached state. Keep it outside version control.
POWERCONTEXT_HOME=<powercontext-home>
